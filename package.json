{
  "name": "retro-radio-desktop",
  "version": "1.0.1",
  "description": "复古网络收音机桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.retro.radio",
    "productName": "复古网络收音机",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app.js",
      "channels.js",
      "index.html",
      "main.js",
      "preload.js",
      "styles.css",
      "package.json"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-packager": "^17.1.2"
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
