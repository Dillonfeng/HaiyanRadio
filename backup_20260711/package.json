{
  "name": "retro-radio-desktop",
  "version": "1.0.0",
  "description": "复古网络收音机桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . --platform=win32 --arch=x64 --out=dist --overwrite"
  },
  "build": {
    "appId": "com.retro.radio",
    "productName": "复古网络收音机",
    "directories": {
      "output": "dist"
    },
    "forceCodeSigning": false,
    "electronDownload": {
      "cache": "./electron-cache"
    },
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-packager": "^17.1.2"
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
