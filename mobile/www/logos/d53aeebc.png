{
	if ( $("zp") != null )
	{
		$("zp").innerHTML = '<embed src="/flash/zp.swf" width="270" height="300" type="application/x-shockwave-flash" play="true" loop="true" menu="true" wmode="Window" scale="showall" quality="high"></embed>';
