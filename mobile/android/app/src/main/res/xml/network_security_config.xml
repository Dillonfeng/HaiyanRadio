<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">cnr.cn</domain>
        <domain includeSubdomains="true">ngcdn002.cnr.cn</domain>
        <domain includeSubdomains="true">satellitepull.cnr.cn</domain>
        <domain includeSubdomains="true">*.cnr.cn</domain>
    </domain-config>
</network-security-config>